// src/pages/ProfilePage.tsx
// Private profile page — only visible to the logged-in user.
// Features:
//  • Profile picture upload (compressed ≤50KB, stored as Firestore string)
//  • Display name & bio editing
//  • Coding platform username links
//  • Privacy toggle (public / private)
//  • Shareable link copy
//  • Stats: problems solved per platform
//  • Full solved problem list (marked completed)

import React, { useEffect, useRef, useState } from "react";
import {
  Camera,
  Check,
  Copy,
  ExternalLink,
  Globe,
  Lock,
  Pencil,
  Save,
  X,
} from "lucide-react";
import { useAuth } from "../hooks/useAuth"; // adjust to your auth hook
import { useProblems } from "../hooks/useProblems"; // adjust to your problems hook
import {
  compressImageToDataURL,
  getProfile,
  upsertProfile,
} from "../lib/profileService";
import { CODING_PLATFORMS, type UserProfile } from "../types/profile";

// ─── tiny helpers ─────────────────────────────────────────────────────────────

const APP_URL =
  typeof window !== "undefined"
    ? window.location.origin
    : "https://your-app.vercel.app";

function StatPill({
  label,
  value,
  color,
}: {
  label: string;
  value: number;
  color: string;
}) {
  return (
    <div
      className="flex flex-col items-center rounded-xl px-4 py-3 min-w-[90px]"
      style={{ background: `${color}22`, border: `1.5px solid ${color}55` }}
    >
      <span
        className="text-2xl font-bold"
        style={{ color }}
      >
        {value}
      </span>
      <span className="text-xs text-gray-400 mt-0.5 text-center leading-tight">
        {label}
      </span>
    </div>
  );
}

// ─── Component ────────────────────────────────────────────────────────────────

export default function ProfilePage() {
  const { user } = useAuth();
  const { problems } = useProblems(); // array of all problems the user tracks

  const [profile, setProfile] = useState<UserProfile | null>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [editMode, setEditMode] = useState(false);
  const [copied, setCopied] = useState(false);

  // editable fields
  const [displayName, setDisplayName] = useState("");
  const [bio, setBio] = useState("");
  const [platforms, setPlatforms] = useState<Record<string, string>>({});
  const [isPublic, setIsPublic] = useState(true);
  const [photoURL, setPhotoURL] = useState("");

  const fileInputRef = useRef<HTMLInputElement>(null);

  // ── load profile ────────────────────────────────────────────────────────────
  useEffect(() => {
    if (!user) return;
    getProfile(user.uid).then((p) => {
      if (p) {
        setProfile(p);
        setDisplayName(p.displayName || user.displayName || "");
        setBio(p.bio || "");
        setPlatforms(p.platforms || {});
        setIsPublic(p.isPublic ?? true);
        setPhotoURL(p.photoURL || user.photoURL || "");
      } else {
        setDisplayName(user.displayName || "");
        setPhotoURL(user.photoURL || "");
        setIsPublic(true);
      }
      setLoading(false);
    });
  }, [user]);

  // ── derived stats ────────────────────────────────────────────────────────────
  const completedProblems = problems.filter(
    (p: any) => p.status === "completed" || p.completed
  );

  // Count by platform tag if problems have a platform field
  const platformCounts: Record<string, number> = {};
  for (const p of completedProblems) {
    const tag = (p.platform || "other").toLowerCase();
    platformCounts[tag] = (platformCounts[tag] || 0) + 1;
  }

  // ── photo upload ─────────────────────────────────────────────────────────────
  async function handlePhotoChange(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      const dataUrl = await compressImageToDataURL(file, 50, 200);
      setPhotoURL(dataUrl);
    } catch {
      alert("Failed to process image. Please try another file.");
    }
  }

  // ── save ─────────────────────────────────────────────────────────────────────
  async function handleSave() {
    if (!user) return;
    setSaving(true);
    try {
      await upsertProfile(user.uid, {
        displayName,
        bio,
        platforms,
        isPublic,
        photoURL,
        shareSlug: profile?.shareSlug || user.uid,
      });
      setProfile((prev) =>
        prev
          ? { ...prev, displayName, bio, platforms, isPublic, photoURL }
          : null
      );
      setEditMode(false);
    } catch (err) {
      alert("Failed to save profile. Please try again.");
    } finally {
      setSaving(false);
    }
  }

  // ── copy share link ───────────────────────────────────────────────────────────
  function copyShareLink() {
    const slug = profile?.shareSlug || user?.uid || "";
    navigator.clipboard.writeText(`${APP_URL}/profile/${slug}`);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64 text-gray-400">
        Loading profile…
      </div>
    );
  }

  const shareSlug = profile?.shareSlug || user?.uid || "";
  const shareUrl = `${APP_URL}/profile/${shareSlug}`;

  return (
    <div className="max-w-2xl mx-auto px-4 py-8 space-y-6">
      {/* ── Header card ── */}
      <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
        <div className="flex items-start gap-5">
          {/* Avatar */}
          <div className="relative shrink-0">
            <div className="w-20 h-20 rounded-full overflow-hidden border-2 border-purple-500/60 bg-gray-800">
              {photoURL ? (
                <img
                  src={photoURL}
                  alt="Profile"
                  className="w-full h-full object-cover"
                />
              ) : (
                <div className="w-full h-full flex items-center justify-center text-3xl">
                  {(displayName || user?.email || "?")[0].toUpperCase()}
                </div>
              )}
            </div>
            {editMode && (
              <>
                <button
                  onClick={() => fileInputRef.current?.click()}
                  className="absolute -bottom-1 -right-1 bg-purple-600 hover:bg-purple-500 rounded-full p-1.5 transition-colors"
                  title="Change photo"
                >
                  <Camera className="w-3.5 h-3.5 text-white" />
                </button>
                <input
                  ref={fileInputRef}
                  type="file"
                  accept="image/*"
                  className="hidden"
                  onChange={handlePhotoChange}
                />
              </>
            )}
          </div>

          {/* Name / bio */}
          <div className="flex-1 min-w-0">
            {editMode ? (
              <div className="space-y-2">
                <input
                  className="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-white text-lg font-semibold focus:outline-none focus:border-purple-500"
                  value={displayName}
                  onChange={(e) => setDisplayName(e.target.value)}
                  placeholder="Display name"
                />
                <textarea
                  className="w-full bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-gray-300 text-sm focus:outline-none focus:border-purple-500 resize-none"
                  rows={2}
                  value={bio}
                  onChange={(e) => setBio(e.target.value)}
                  placeholder="Short bio (optional)"
                />
              </div>
            ) : (
              <>
                <h1 className="text-xl font-bold text-white truncate">
                  {displayName || user?.email || "Anonymous"}
                </h1>
                {bio && (
                  <p className="text-sm text-gray-400 mt-1 line-clamp-2">
                    {bio}
                  </p>
                )}
              </>
            )}
          </div>

          {/* Edit / Save / Cancel */}
          <div className="flex gap-2 shrink-0">
            {editMode ? (
              <>
                <button
                  onClick={handleSave}
                  disabled={saving}
                  className="flex items-center gap-1 bg-purple-600 hover:bg-purple-500 disabled:opacity-50 text-white text-sm px-3 py-1.5 rounded-lg transition-colors"
                >
                  <Save className="w-3.5 h-3.5" />
                  {saving ? "Saving…" : "Save"}
                </button>
                <button
                  onClick={() => setEditMode(false)}
                  className="flex items-center gap-1 bg-white/5 hover:bg-white/10 text-gray-300 text-sm px-3 py-1.5 rounded-lg transition-colors"
                >
                  <X className="w-3.5 h-3.5" />
                  Cancel
                </button>
              </>
            ) : (
              <button
                onClick={() => setEditMode(true)}
                className="flex items-center gap-1 bg-white/5 hover:bg-white/10 text-gray-300 text-sm px-3 py-1.5 rounded-lg transition-colors"
              >
                <Pencil className="w-3.5 h-3.5" />
                Edit
              </button>
            )}
          </div>
        </div>

        {/* Privacy toggle + share link */}
        <div className="mt-5 flex flex-col sm:flex-row gap-3">
          {/* Public / Private toggle */}
          <button
            onClick={() => {
              if (editMode) setIsPublic((v) => !v);
            }}
            title={editMode ? "Toggle visibility" : "Edit profile to change"}
            className={`flex items-center gap-2 text-sm px-3 py-1.5 rounded-lg border transition-colors ${
              isPublic
                ? "border-green-500/40 bg-green-500/10 text-green-400"
                : "border-gray-500/40 bg-gray-500/10 text-gray-400"
            } ${editMode ? "cursor-pointer hover:opacity-80" : "cursor-default"}`}
          >
            {isPublic ? (
              <Globe className="w-4 h-4" />
            ) : (
              <Lock className="w-4 h-4" />
            )}
            {isPublic ? "Public profile" : "Private profile"}
          </button>

          {/* Share link */}
          {isPublic && (
            <div className="flex flex-1 items-center gap-2 bg-white/5 border border-white/10 rounded-lg px-3 py-1.5">
              <span className="text-xs text-gray-400 truncate flex-1">
                {shareUrl}
              </span>
              <button
                onClick={copyShareLink}
                className="shrink-0 text-purple-400 hover:text-purple-300 transition-colors"
                title="Copy link"
              >
                {copied ? (
                  <Check className="w-4 h-4 text-green-400" />
                ) : (
                  <Copy className="w-4 h-4" />
                )}
              </button>
              <a
                href={shareUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="shrink-0 text-purple-400 hover:text-purple-300 transition-colors"
                title="Open public profile"
              >
                <ExternalLink className="w-4 h-4" />
              </a>
            </div>
          )}
        </div>
      </div>

      {/* ── Stats ── */}
      <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
        <h2 className="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
          Problems Solved
        </h2>
        <div className="flex flex-wrap gap-3">
          <StatPill
            label="Total"
            value={completedProblems.length}
            color="#a855f7"
          />
          {CODING_PLATFORMS.filter((pl) => platformCounts[pl.id] > 0).map(
            (pl) => (
              <StatPill
                key={pl.id}
                label={pl.label}
                value={platformCounts[pl.id] || 0}
                color={pl.color}
              />
            )
          )}
          {completedProblems.length === 0 && (
            <p className="text-sm text-gray-500">
              No problems completed yet — start solving!
            </p>
          )}
        </div>
      </div>

      {/* ── Coding Platforms ── */}
      <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
        <h2 className="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
          Coding Profiles
        </h2>
        <div className="space-y-3">
          {CODING_PLATFORMS.map((pl) => {
            const username = platforms[pl.id] || "";
            return (
              <div key={pl.id} className="flex items-center gap-3">
                <span
                  className="text-lg w-7 text-center"
                  title={pl.label}
                >
                  {pl.icon}
                </span>
                <span className="w-28 text-sm text-gray-400 shrink-0">
                  {pl.label}
                </span>
                {editMode ? (
                  <input
                    className="flex-1 bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-white text-sm focus:outline-none focus:border-purple-500"
                    value={username}
                    onChange={(e) =>
                      setPlatforms((prev) => ({
                        ...prev,
                        [pl.id]: e.target.value,
                      }))
                    }
                    placeholder={pl.placeholder}
                  />
                ) : username ? (
                  <a
                    href={`${pl.baseUrl}${username}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-1 text-sm text-purple-400 hover:text-purple-300 transition-colors"
                  >
                    @{username}
                    <ExternalLink className="w-3 h-3" />
                  </a>
                ) : (
                  <span className="text-sm text-gray-600">—</span>
                )}
              </div>
            );
          })}
        </div>
      </div>

      {/* ── Completed problems list ── */}
      <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
        <h2 className="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
          Solved Problems ({completedProblems.length})
        </h2>
        {completedProblems.length === 0 ? (
          <p className="text-sm text-gray-500">No problems solved yet.</p>
        ) : (
          <div className="space-y-2 max-h-96 overflow-y-auto pr-1">
            {completedProblems.map((p: any) => (
              <SolvedProblemRow key={p.id} problem={p} />
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

// ── Solved problem row ────────────────────────────────────────────────────────

function SolvedProblemRow({ problem }: { problem: any }) {
  const difficultyColor: Record<string, string> = {
    easy: "#22c55e",
    medium: "#f59e0b",
    hard: "#ef4444",
  };
  const diff = (problem.difficulty || "").toLowerCase();
  const completedAt = problem.completedAt
    ? new Date(problem.completedAt).toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        year: "numeric",
      })
    : null;

  return (
    <div className="flex items-center gap-3 py-2 px-3 rounded-lg bg-white/3 hover:bg-white/5 transition-colors group">
      <Check className="w-4 h-4 text-green-400 shrink-0" />
      <div className="flex-1 min-w-0">
        <span className="text-sm text-white truncate block">
          {problem.title || problem.name || "Untitled"}
        </span>
        {completedAt && (
          <span className="text-xs text-gray-500">{completedAt}</span>
        )}
      </div>
      {diff && (
        <span
          className="text-xs font-semibold px-2 py-0.5 rounded-full"
          style={{
            color: difficultyColor[diff] || "#9ca3af",
            background: `${difficultyColor[diff] || "#9ca3af"}22`,
          }}
        >
          {diff.charAt(0).toUpperCase() + diff.slice(1)}
        </span>
      )}
      {problem.link && (
        <a
          href={problem.link}
          target="_blank"
          rel="noopener noreferrer"
          className="shrink-0 text-gray-600 hover:text-purple-400 transition-colors opacity-0 group-hover:opacity-100"
          title="Open problem"
        >
          <ExternalLink className="w-3.5 h-3.5" />
        </a>
      )}
    </div>
  );
}