// src/pages/PublicProfilePage.tsx
// Publicly shareable profile page — no auth required.
// Route: /profile/:slug
// Shows: avatar, name, bio, stats, coding platform links, solved problems list.

import React, { useEffect, useState } from "react";
import { useParams } from "@tanstack/react-router"; // adjust if using react-router
import { Check, ExternalLink, Globe, Lock } from "lucide-react";
import { getProfileBySlug } from "../lib/profileService";
import { CODING_PLATFORMS, type UserProfile } from "../types/profile";

// ─── Helpers ──────────────────────────────────────────────────────────────────

// We don't have access to the private problems hook here.
// Instead we read a `solvedProblems` snapshot that we persist to Firestore
// whenever the user marks a problem done (see note below).
// For now, we load them from the profile doc's optional `solvedProblems` field.

function StatPill({
  label,
  value,
  color,
}: {
  label: string;
  value: number;
  color: string;
}) {
  return (
    <div
      className="flex flex-col items-center rounded-xl px-4 py-3 min-w-[90px]"
      style={{ background: `${color}22`, border: `1.5px solid ${color}55` }}
    >
      <span className="text-2xl font-bold" style={{ color }}>
        {value}
      </span>
      <span className="text-xs text-gray-400 mt-0.5 text-center leading-tight">
        {label}
      </span>
    </div>
  );
}

// ─── Component ────────────────────────────────────────────────────────────────

export default function PublicProfilePage() {
  // TanStack Router v1 style — swap for useParams() from react-router if needed
  const { slug } = useParams({ strict: false }) as { slug: string };

  const [profile, setProfile] = useState<
    (UserProfile & { solvedProblems?: any[] }) | null
  >(null);
  const [loading, setLoading] = useState(true);
  const [notFound, setNotFound] = useState(false);

  useEffect(() => {
    if (!slug) return;
    getProfileBySlug(slug)
      .then((p) => {
        if (!p || !p.isPublic) {
          setNotFound(true);
        } else {
          setProfile(p as any);
        }
        setLoading(false);
      })
      .catch(() => {
        setNotFound(true);
        setLoading(false);
      });
  }, [slug]);

  if (loading) {
    return (
      <div className="min-h-screen bg-[#0f0f1a] flex items-center justify-center">
        <div className="text-gray-400 text-sm animate-pulse">
          Loading profile…
        </div>
      </div>
    );
  }

  if (notFound || !profile) {
    return (
      <div className="min-h-screen bg-[#0f0f1a] flex flex-col items-center justify-center gap-4">
        <Lock className="w-12 h-12 text-gray-600" />
        <h1 className="text-xl font-bold text-white">Profile not found</h1>
        <p className="text-gray-400 text-sm">
          This profile is private or doesn't exist.
        </p>
        <a
          href="/"
          className="mt-2 text-purple-400 hover:text-purple-300 text-sm underline"
        >
          Go to DSA Tracker
        </a>
      </div>
    );
  }

  // ── Derived stats ─────────────────────────────────────────────────────────
  const solved: any[] = profile.solvedProblems || [];
  const platformCounts: Record<string, number> = {};
  for (const p of solved) {
    const tag = (p.platform || "other").toLowerCase();
    platformCounts[tag] = (platformCounts[tag] || 0) + 1;
  }

  const difficultyColor: Record<string, string> = {
    easy: "#22c55e",
    medium: "#f59e0b",
    hard: "#ef4444",
  };

  const filledPlatforms = CODING_PLATFORMS.filter(
    (pl) => profile.platforms?.[pl.id]
  );

  return (
    <div className="min-h-screen bg-[#0f0f1a] text-white">
      {/* Nav bar */}
      <header className="border-b border-white/10 px-4 py-3 flex items-center justify-between">
        <a href="/" className="text-purple-400 font-bold text-sm hover:text-purple-300">
          ← DSA Tracker
        </a>
        <span className="flex items-center gap-1 text-xs text-green-400">
          <Globe className="w-3 h-3" />
          Public Profile
        </span>
      </header>

      <main className="max-w-2xl mx-auto px-4 py-8 space-y-6">
        {/* ── Profile header ── */}
        <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
          <div className="flex items-start gap-5">
            {/* Avatar */}
            <div className="w-20 h-20 rounded-full overflow-hidden border-2 border-purple-500/60 bg-gray-800 shrink-0">
              {profile.photoURL ? (
                <img
                  src={profile.photoURL}
                  alt={profile.displayName}
                  className="w-full h-full object-cover"
                />
              ) : (
                <div className="w-full h-full flex items-center justify-center text-3xl">
                  {(profile.displayName || "?")[0].toUpperCase()}
                </div>
              )}
            </div>

            <div className="flex-1 min-w-0">
              <h1 className="text-xl font-bold text-white truncate">
                {profile.displayName || "Anonymous Coder"}
              </h1>
              {profile.bio && (
                <p className="text-sm text-gray-400 mt-1 line-clamp-3">
                  {profile.bio}
                </p>
              )}
            </div>
          </div>
        </div>

        {/* ── Stats ── */}
        <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
          <h2 className="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
            Problems Solved
          </h2>
          <div className="flex flex-wrap gap-3">
            <StatPill label="Total" value={solved.length} color="#a855f7" />
            {CODING_PLATFORMS.filter((pl) => platformCounts[pl.id] > 0).map(
              (pl) => (
                <StatPill
                  key={pl.id}
                  label={pl.label}
                  value={platformCounts[pl.id] || 0}
                  color={pl.color}
                />
              )
            )}
            {solved.length === 0 && (
              <p className="text-sm text-gray-500">
                No problems logged yet.
              </p>
            )}
          </div>
        </div>

        {/* ── Coding Platforms ── */}
        {filledPlatforms.length > 0 && (
          <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
            <h2 className="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
              Coding Profiles
            </h2>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {filledPlatforms.map((pl) => {
                const username = profile.platforms[pl.id];
                return (
                  <a
                    key={pl.id}
                    href={`${pl.baseUrl}${username}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-3 px-4 py-3 rounded-xl border border-white/10 hover:border-white/20 bg-white/3 hover:bg-white/6 transition-all group"
                  >
                    <span className="text-xl">{pl.icon}</span>
                    <div className="flex-1 min-w-0">
                      <div className="text-xs text-gray-400">{pl.label}</div>
                      <div
                        className="text-sm font-medium truncate"
                        style={{ color: pl.color }}
                      >
                        @{username}
                      </div>
                    </div>
                    <ExternalLink className="w-4 h-4 text-gray-600 group-hover:text-gray-400 transition-colors shrink-0" />
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {/* ── Solved problems list ── */}
        {solved.length > 0 && (
          <div className="rounded-2xl bg-[#1a1a2e] border border-white/10 p-6">
            <h2 className="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">
              Solved Problems ({solved.length})
            </h2>
            <div className="space-y-2 max-h-96 overflow-y-auto pr-1">
              {solved.map((p: any, i: number) => {
                const diff = (p.difficulty || "").toLowerCase();
                const completedAt = p.completedAt
                  ? new Date(p.completedAt).toLocaleDateString("en-IN", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                    })
                  : null;
                return (
                  <div
                    key={p.id || i}
                    className="flex items-center gap-3 py-2 px-3 rounded-lg bg-white/3 hover:bg-white/5 transition-colors group"
                  >
                    <Check className="w-4 h-4 text-green-400 shrink-0" />
                    <div className="flex-1 min-w-0">
                      <span className="text-sm text-white truncate block">
                        {p.title || p.name || "Untitled"}
                      </span>
                      {completedAt && (
                        <span className="text-xs text-gray-500">
                          {completedAt}
                        </span>
                      )}
                    </div>
                    {diff && (
                      <span
                        className="text-xs font-semibold px-2 py-0.5 rounded-full shrink-0"
                        style={{
                          color: difficultyColor[diff] || "#9ca3af",
                          background: `${
                            difficultyColor[diff] || "#9ca3af"
                          }22`,
                        }}
                      >
                        {diff.charAt(0).toUpperCase() + diff.slice(1)}
                      </span>
                    )}
                    {p.link && (
                      <a
                        href={p.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="shrink-0 text-gray-600 hover:text-purple-400 transition-colors opacity-0 group-hover:opacity-100"
                      >
                        <ExternalLink className="w-3.5 h-3.5" />
                      </a>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Footer */}
        <div className="text-center text-xs text-gray-600 pb-4">
          Made with{" "}
          <a href="/" className="text-purple-500 hover:text-purple-400">
            DSA Tracker
          </a>
        </div>
      </main>
    </div>
  );
}