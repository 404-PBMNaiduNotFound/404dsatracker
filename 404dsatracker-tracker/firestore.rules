rules_version = '2';

// Equivalent of the old Postgres RLS policies (every policy in
// supabase/migrations/*.sql was "own row only" — auth.uid() = user_id).
// Firestore's path structure already scopes each user to users/{uid}/**,
// but these rules are still required as defense-in-depth: without them,
// any authenticated client could read/write any path.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // usernames/{username} -> { uid } — the uniqueness index behind the
    // /profile/{username} shareable links. World-readable so the signup
    // form's live availability check and the public profile route both
    // work without login. A username can only be created by the account
    // it belongs to, only once (no stealing an existing one), and only
    // its current owner may repoint or touch it afterwards.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      // Only the current owner may release (delete) their own claimed
      // username — needed so account deletion can free it up for reuse.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // Public profile fields (displayName, photoURL, bio, codingProfiles, publicStats)
      // are intentionally world-readable so the shareable /profile/[uid] route works
      // without login. Write access remains owner-only.
      //
      // IMPORTANT: this doc must NEVER contain private fields (email, etc.) —
      // Firestore rules can't do field-level filtering, so "allow read: if true"
      // exposes the ENTIRE document, not just the fields the app's UI happens to
      // display. Private data (e.g. the `aboutMe` notes-to-self field) lives in
      // the owner-only users/{uid}/private/{docId} subcollection below instead.
      allow read: if true;
      allow write: if isOwner(uid);

      // Private profile data (e.g. `aboutMe`) — NEVER world-readable, unlike the
      // parent doc. Read/write restricted to the account owner only.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Plan days, sync metadata, notes/chat history, and revision-event log —
      // all freely readable/writable by their owner, same as the old
      // "own days / own meta / own events" RLS policies.
      // Plan days — readable by anyone so the public /profile/[uid] page
      // can render heatmaps and stats without requiring the visitor to log in.
      // Write access remains owner-only.
      match /days/{dayNumber} {
        allow read: if true;
        allow write: if isOwner(uid);
      }

      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /revisionEvents/{eventId} {
        allow read, write: if isOwner(uid);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Achievements are informational badges. The app currently computes
      // them client-side on every read (src/lib/gamification.ts) and never
      // persists them, so this collection is unused today — but per the
      // migration brief, writes are restricted to the Cloud Functions
      // Admin SDK (which bypasses rules entirely) to prevent a user from
      // granting themselves badges directly, should persistence be added
      // later. Reads stay open to the owner.
      match /achievements/{code} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Push subscription documents are keyed by the device's FCM token.
      match /pushSubscriptions/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      // Topic reminders stored per user.
      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
